{
  "name": "@ratmath/core",
  "version": "0.11.0",
  "description": "Exact integers, rational numbers, fractions, rational intervals and interval sets, and certified approximations",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./refine": {
      "types": "./refine.d.ts",
      "import": "./src/refine.js",
      "default": "./src/refine.js"
    },
    "./units": {
      "types": "./units.d.ts",
      "import": "./src/units.js",
      "default": "./src/units.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "index.js",
    "index.d.ts",
    "refine.d.ts",
    "units.d.ts",
    "src/"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:examples": "bash scripts/test-examples.sh",
    "test:pack": "npm pack --dry-run --cache ./tmp/npm-cache",
    "prepublishOnly": "bunx bun@1.4.2 test --coverage && npm run test:examples && npm run test:pack",
    "docs:build": "bun scripts/build-docs.js"
  },
  "keywords": [
    "rational",
    "fraction",
    "arithmetic",
    "interval",
    "continued-fraction",
    "repeating-decimal",
    "certified-approximation",
    "uncertainty",
    "exact",
    "mathematics",
    "bigint",
    "units"
  ],
  "author": "James Taylor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratmath/core.git"
  },
  "homepage": "https://ratmath.com/core/",
  "bugs": {
    "url": "https://github.com/ratmath/core/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "bun-types": "1.3.14",
    "katex": "0.19.1"
  }
}
